# ── WarriorCRM lead forwarding ───────────────────────────────────────────────
# Set BOTH in Vercel ▸ Project ▸ Settings ▸ Environment Variables (Production).
# The publishable key is frontend-safe by design and can only INSERT into the
# CRM's public_leads queue — it cannot read any CRM data.
WARRIORCRM_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
WARRIORCRM_SUPABASE_KEY=your-supabase-publishable-key

# ── Legacy generic webhook (optional fallback) ───────────────────────────────
# Used only if the two WARRIORCRM_* vars above are not set.
# CRM_WEBHOOK_URL=https://example.com/webhook
# CRM_API_KEY=
