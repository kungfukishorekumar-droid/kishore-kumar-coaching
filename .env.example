# =====================================================================
#  Kishore Kumar Coaching (landing page) — environment variables
#  Copy this file to .env.local for local dev.
#
#  Shares its layout and variable names with the Warrior Mind Backend, so one
#  value means the same thing in both repos. Sections marked NOT USED HERE are
#  read by that backend, not by this Next.js app — they are kept so the two
#  files stay diffable.
#
#  Production does NOT read this file: Hostinger runs the app from Git, so set
#  these in hPanel → Node application → Environment.
#  Check a running deployment with:  GET /api/health/
# =====================================================================

# ---- Supabase ----
# The WarriorCRM intake queue. NOTE THE MISSING NEXT_PUBLIC_ PREFIX: that prefix
# is what would inline a value into the browser bundle, so leaving it off is
# what keeps the key server-only. With the service-role key set, this server is
# the only writer to public_leads and you can revoke the anon INSERT policy.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Server ----
# NOT USED HERE. Next owns the port (npm run dev → 3000) and sets NODE_ENV
# itself; setting NODE_ENV in an env file makes Next warn and can break a
# production start. Listed for parity with the backend only.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- Admin ----
# NOT USED HERE. This site has no login and no admin surface — there is no JWT
# to sign. Set these in the backend repo, not this one.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_PASSWORD=

# ---- Razorpay ----
# NOT USED HERE. Payments live in the backend repo. From Razorpay Dashboard →
# Settings → API Keys. The KEY_ID and KEY_SECRET are TWO DIFFERENT values. The
# secret is used only on the backend to create orders and verify signatures —
# never expose it to the frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ---- Integrations (optional) ----
# NOT USED HERE.
N8N_WEBHOOK_URL=

# ---- Warrior CRM (Spartacus Martial Arts) ----
# Leads are POSTed to the ingest endpoint with the API key in the x-api-key
# header, in parallel with the Supabase queue above — either one succeeding is
# enough, so neither is a single point of failure.
# Leave CRM_WEBHOOK_URL empty to disable (leads then reach the CRM via the
# queue only). Get the key from the CRM: Sites → Spartacus Martial Arts.
CRM_WEBHOOK_URL=https://crm.spartacusmartialarts.com/api/ingest/spartacus
CRM_API_KEY=wcrm_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CRM_SITE_SLUG=spartacus

# ---- CORS ----
# Comma-separated list of extra origins allowed to POST /api/lead/. Same-origin
# is always allowed, so this is only for another site submitting into this
# endpoint. LEAD_ALLOWED_ORIGINS is read first if both are set.
ALLOWED_ORIGINS=
LEAD_ALLOWED_ORIGINS=

# Razorpay webhook secret (set separately in the Razorpay dashboard when you
# configure the webhook — NOT the same as your API key/secret).
# NOT USED HERE — backend repo only.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_if_used

# ---- Cloudflare Turnstile (bot protection) ----
# Both halves or neither. The site key renders the widget; the secret is what
# lets the server verify the token. A widget without server verification stops
# nothing — a bot just calls the API directly. While the secret is unset, the
# rate limiter and the honeypot field are the only bot defences.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Site ----
# Canonical origin for sitemap, robots, RSS and og: tags. Defaults to the
# production domain, so set it only for previews/staging.
NEXT_PUBLIC_SITE_URL=https://kishorekumarcoach.com

# ---- Rate limiting (optional tuning) ----
# Two tiers. BURST counts every request and stops hammering; RATE_LIMIT_MAX
# counts only accepted, non-duplicate leads and caps how many rows one address
# can create — so a visitor who mistypes their phone number is never locked out.
# State is per Node process: a restart clears it.
LEAD_BURST_LIMIT_MAX=30
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_MS=600000
LEAD_MAX_BODY_BYTES=16384
LEAD_DEDUPE_WINDOW_MS=300000
