# ── Lead form → WarriorCRM (Supabase) ────────────────────────────────────
# The site is a STATIC export served by Hostinger — there is no Node server
# and no /api/lead route. The form posts straight from the browser into the
# CRM's `public_leads` queue, so both values below are baked into the client
# bundle at build time and are PUBLIC by design.
#
# That is safe only because of Supabase row-level security: this key may
# INSERT into public_leads and nothing else. It can never read CRM data.
# Never put the service_role key here — it would be published to the world.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Site URL ─────────────────────────────────────────────────────────────
# Canonical origin used for sitemap, robots, RSS and og: tags. Defaults to
# the production domain, so you only set this for previews/staging.
# NEXT_PUBLIC_SITE_URL=https://kishorekumarcoach.com

# ── Where these live in production ───────────────────────────────────────
# Local dev: copy this file to `.env.local`.
# Production: GitHub → repo Settings → Secrets and variables → Actions.
# The deploy workflow (.github/workflows/deploy-hostinger.yml) reads them
# there and bakes them into the build before uploading to Hostinger.
#
# If you set NEXT_PUBLIC_SUPABASE_URL, also update the `connect-src` host in
# public/.htaccess — the browser's CSP will block the request otherwise.
